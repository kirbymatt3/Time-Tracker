        <name>Save as Template</name>
        <onclick>saveAsTemplate()</onclick>
        <order>100</order>
        <script><![CDATA[function saveAsTemplate() {
    var proj = g_form.getValue('project');
    var hrs = g_form.getValue('hours');
    var comment = g_form.getValue('comment');

    if (!proj || !hrs) {
        alert('Please select a Project and enter Hours before saving as a template.');
        return;
    }

    var tmplName = prompt('Enter a name for this Time Entry Template (e.g., Daily Dev Work):');
    if (!tmplName) {
        return;
    }

    var ga = new GlideAjax('x_783736_time_tr_0.TimeTrackerUtils');
    ga.addParam('sysparm_name', 'createTemplateFromForm');
    ga.addParam('sysparm_tmpl_name', tmplName);
    ga.addParam('sysparm_project', proj);
    ga.addParam('sysparm_hours', hrs);
    ga.addParam('sysparm_comment', comment);

    ga.getXMLAnswer(function(newId) {
        if (newId) {
            g_form.addInfoMessage('Template "' + tmplName + '" saved! Pick it anytime from Apply Template.');
        }
    });
}
]]></script>
